 <?php 
 
function get_price($name) 
{ 
    /* JSON file INFO */ 
    $jsonFile = "data.json"; 
 
    // Read the file 
    $json = file_get_contents($jsonFile); 
    if ($json === false) { 
        die("Could not read " . $jsonFile); } 
 
    // Decode into an associative array 
    $data = json_decode($json, true); 
    if ($data === null || !isset($data["items"])) { 
        die("Invalid JSON in " . $jsonFile); 
    } 
 
    // Look up the price for the county (same as SELECT price FROM items WHERE county = '$name') 
    $p = null; 
    foreach ($data["items"] as $row) { 
        if ($row["county"] == $name) { 
            $p = $row["price"]; 
        } 
    } 
 
	return "$" . $p;  
} 
 
?> 